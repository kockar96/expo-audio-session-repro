+// REPRO instrumentation, not part of expo-audio.
+private let reproArm = ProcessInfo.processInfo.arguments
+  .first { $0.hasPrefix("--arm=") }?.dropFirst("--arm=".count).description ?? ""
+private let reproDeactivationGeneration = ReproLocked(0)
+private let reproEventFile: FileHandle? = {
+  let run = ProcessInfo.processInfo.arguments.first { $0.hasPrefix("--run=") }?.dropFirst("--run=".count).description ?? "manual"
+  let url = FileManager.default.urls(for: .documentDirectory, in: .userDomainMask)[0].appendingPathComponent("events-\(run).log")
+  FileManager.default.createFile(atPath: url.path, contents: nil)
+  return try? FileHandle(forWritingTo: url)
+}()
+private let reproEventQueue = DispatchQueue(label: "repro.events")
+private func reproEvent(_ name: String) {
+  let ms = Double(DispatchTime.now().uptimeNanoseconds) / 1_000_000
+  reproEventQueue.async { reproEventFile?.write(Data(String(format: "%.1f %@\n", ms, name).utf8)) }
+}
+private final class ReproLocked {
+  private let lock = NSLock()
+  private var value: Int
+  init(_ value: Int) { self.value = value }
+  func withLock<T>(_ body: (inout Int) -> T) -> T {
+    lock.lock(); defer { lock.unlock() }
+    return body(&value)
   }
 }
